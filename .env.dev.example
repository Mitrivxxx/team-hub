# Team Hub — Compose DEV (infra + monitoring companion for Aspire).
# Copy: cp .env.dev.example .env.dev
# Do not commit .env.dev.
# Start: ./scripts/compose-dev.sh up -d --wait  (or ./scripts/dev-up.sh)

COMPOSE_PROJECT_NAME=team-hub-dev

# --- Postgres (Aspire apps use auth_db / organization_db / notification_db / chat_db) ---
POSTGRES_USER=teamhub
POSTGRES_PASSWORD=teamhub-dev-password
POSTGRES_PORT=5433
POSTGRES_CONTAINER_NAME=db-postgres-dev
POSTGRES_VOLUME_NAME=postgres_data_dev
POSTGRES_INIT_SCRIPT=01-create-dbs-dev.sql

# --- PgAdmin (compose-dev only; UI for db-postgres) ---
PGADMIN_CONTAINER_NAME=db-pgadmin-dev
PGADMIN_PORT=5050
PGADMIN_DEFAULT_EMAIL=admin@example.com
PGADMIN_DEFAULT_PASSWORD=admin
PGADMIN_VOLUME_NAME=pgadmin_data_dev

# --- Redis ---
REDIS_CONTAINER_NAME=cache-redis-dev
REDIS_PORT=6379

# --- Kafka (host Aspire processes — advertised must be loopback, not msg-kafka) ---
KAFKA_CONTAINER_NAME=msg-kafka-dev
KAFKA_PORT=9092
KAFKA_ADVERTISED_HOST=127.0.0.1

# --- Azurite (blob emulator) ---
AZURITE_CONTAINER_NAME=blob-storage-dev
AZURITE_BLOB_PORT=10000
AZURITE_VOLUME_NAME=azurite_data_dev
# Well-known Azurite emulator account (public Microsoft test values, not a prod secret).
# Docs: https://learn.microsoft.com/azure/storage/common/storage-use-azurite
BlobStorage__ConnectionString=DefaultEndpointsProtocol=http;AccountName=devstoreaccount1;AccountKey=Eby8vdM02xNOcqFlqUwJPLlmEtlCDXJ1OUzFT50uSRZ6IFsuFq2UVErCz4I6tq/K1SZFPTOtr/KBHBeksoGMGw==;BlobEndpoint=http://127.0.0.1:10000/devstoreaccount1;
BlobStorage__ContainerName=avatars
BlobStorage__PublicBlobEndpoint=http://127.0.0.1:10000/devstoreaccount1
BlobStorage__SasExpiryMinutes=60

# --- Monitoring ---
# Grafana (change password before exposing beyond localhost)
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=change-me

GRAFANA_PORT=3000
LOKI_PORT=3100
TEMPO_PORT=3200
PROMETHEUS_PORT=9090
OTEL_COLLECTOR_GRPC_PORT=4317
OTEL_COLLECTOR_HTTP_PORT=4318
NGINX_EXPORTER_PORT=9113

GRAFANA_CONTAINER_NAME=mon-grafana-dev
LOKI_CONTAINER_NAME=mon-loki-dev
TEMPO_CONTAINER_NAME=mon-tempo-dev
PROMETHEUS_CONTAINER_NAME=mon-prometheus-dev
OTEL_COLLECTOR_CONTAINER_NAME=mon-otel-dev
NGINX_EXPORTER_CONTAINER_NAME=mon-nginx-exporter-dev
