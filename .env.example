# Team Hub — env templates (no secrets).
#
# Compose environments (preferred):
#   cp .env.dev.example .env.dev
#   cp .env.staging.example .env.staging
#
# Aspire JWT lives in:
#   aspire/TeamHub.AppHost/appsettings.Development.json
#
# Optional per-service local `dotnet run` (outside Aspire):
#   services/team-hub-*/.env.example → .env (gitignored)
#
# Never commit .env, .env.dev, or .env.staging.
