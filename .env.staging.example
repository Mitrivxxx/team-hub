# Team Hub — Compose STAGING (full stack).
# Copy: cp .env.staging.example .env.staging
# Replace every CHANGE_ME value before `up`. Do not commit .env.staging.

COMPOSE_PROJECT_NAME=team-hub-staging

# --- Postgres ---
POSTGRES_USER=teamhub
POSTGRES_PASSWORD=CHANGE_ME_POSTGRES_PASSWORD
POSTGRES_PORT=5433
POSTGRES_CONTAINER_NAME=db-postgres-staging
POSTGRES_VOLUME_NAME=postgres_data_staging
POSTGRES_INIT_SCRIPT=01-create-dbs-prod.sql

# --- Redis ---
REDIS_CONTAINER_NAME=cache-redis-staging
REDIS_PORT=6379

# --- Kafka ---
KAFKA_CONTAINER_NAME=msg-kafka-staging
KAFKA_PORT=9092
KAFKA_ADVERTISED_HOST=msg-kafka

# --- Azurite (blob emulator for staging) ---
AZURITE_CONTAINER_NAME=blob-storage-staging
AZURITE_BLOB_PORT=10000
AZURITE_VOLUME_NAME=azurite_data_staging
# Well-known Azurite emulator account (public Microsoft test values, not a prod secret).
# Docs: https://learn.microsoft.com/azure/storage/common/storage-use-azurite
BlobStorage__ConnectionString=DefaultEndpointsProtocol=http;AccountName=devstoreaccount1;AccountKey=Eby8vdM02xNOcqFlqUwJPLlmEtlCDXJ1OUzFT50uSRZ6IFsuFq2UVErCz4I6tq/K1SZFPTOtr/KBHBeksoGMGw==;BlobEndpoint=http://blob-storage:10000/devstoreaccount1;
BlobStorage__ContainerName=avatars
BlobStorage__PublicBlobEndpoint=http://127.0.0.1:10000/devstoreaccount1
BlobStorage__SasExpiryMinutes=60

# --- Shared JWT (min 32 chars; same value for all services) ---
Jwt__Key=CHANGE_ME_JWT_KEY_AT_LEAST_32_CHARACTERS_LONG
Jwt__Issuer=AuthService
Jwt__Audience=AuthServiceUsers

# --- App containers ---
AUTH_CONTAINER_NAME=srv-auth-staging
ORG_CONTAINER_NAME=srv-organization-staging
NOTIFICATION_CONTAINER_NAME=srv-notification-staging
BFF_CONTAINER_NAME=srv-bff-staging
GATEWAY_CONTAINER_NAME=gw-api-staging
NGINX_CONTAINER_NAME=gw-nginx-staging
WEB_CONTAINER_NAME=ui-web-staging

# --- Monitoring ---
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=CHANGE_ME_GRAFANA_PASSWORD

GRAFANA_PORT=3000
LOKI_PORT=3100
TEMPO_PORT=3200
PROMETHEUS_PORT=9090
OTEL_COLLECTOR_GRPC_PORT=4317
OTEL_COLLECTOR_HTTP_PORT=4318
NGINX_EXPORTER_PORT=9113

GRAFANA_CONTAINER_NAME=mon-grafana-staging
LOKI_CONTAINER_NAME=mon-loki-staging
TEMPO_CONTAINER_NAME=mon-tempo-staging
PROMETHEUS_CONTAINER_NAME=mon-prometheus-staging
OTEL_COLLECTOR_CONTAINER_NAME=mon-otel-staging
NGINX_EXPORTER_CONTAINER_NAME=mon-nginx-exporter-staging
