# Shared Redis cache (single instance for all services)
#
# Root compose uses committed env files:
# - infrastructure/redis/compose.dev.env
# - infrastructure/redis/compose.prod.env
#
# Copy this file to .env only when running Redis standalone:
#   docker compose -f infrastructure/redis/docker-compose.redis.yml --env-file infrastructure/redis/.env up -d

REDIS_CONTAINER_NAME=team-hub-redis-dev
REDIS_PORT=6379

# Local dev (dotnet run on host)
Redis__ConnectionString=localhost:6379

# Docker network (auth containers)
# Redis__ConnectionString=redis:6379
