# Shared Redis cache (single instance for all services)
#
# Prefer root env for Compose:
#   .env.dev / .env.staging (from .env.*.example)
#
# Standalone Redis only:
#   cp infrastructure/redis/.env.example infrastructure/redis/.env
#   docker compose -f infrastructure/redis/docker-compose.redis.yml --env-file infrastructure/redis/.env up -d

REDIS_CONTAINER_NAME=cache-redis-local
REDIS_PORT=6379

# Host clients (dotnet run / tools on host)
Redis__ConnectionString=localhost:6379

# In-compose network:
# Redis__ConnectionString=cache-redis:6379
